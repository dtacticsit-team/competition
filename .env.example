# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Strongly recommended in production
# Public origin, used for share links, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://kolam.example.com
# Random string; salts the IP hashes kept for vote-abuse detection.
AUTH_SECRET=change-me-to-a-long-random-string
# Competition-creator admin account. Create it with: node scripts/seed-admin.mjs
# Change ADMIN_PASSWORD to a strong password before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Competition Admin
# Comma-separated emails that are granted the admin role at registration/login.
# If unset, the FIRST account ever registered becomes the admin.
ADMIN_EMAILS=admin@example.com

# Optional: transactional email (verification + password reset) via Resend.
# Without these, links are written to the server log instead of being emailed.
RESEND_API_KEY=
MAIL_FROM="Kolam <no-reply@example.com>"

# Optional: enables POST /api/cron for an external cron trigger.
CRON_SECRET=

# Optional: vote-abuse thresholds (likes from one IP on one entry per 24h).
VOTE_FLAG_THRESHOLD=10
VOTE_IP_CAP=50
